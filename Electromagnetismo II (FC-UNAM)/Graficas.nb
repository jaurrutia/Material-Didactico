Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "ColorMapSuitePath", " ", "=", " ", 
   "\"\<~/Documents/Wolfram/ScientificColourMaps8\>\""}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Function", " ", "for", " ", "continuous", " ", "data"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"ColorMapSuite", "[", "name_String", "]"}], " ", ":=", " ", 
  RowBox[{"ColorMapSuite", "[", 
   RowBox[{"name", ",", " ", 
    RowBox[{"-", "1"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ColorMapSuite", "[", 
    RowBox[{"name_String", ",", " ", "el_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", "\n", "    ", 
      RowBox[{"list", " ", "=", " ", 
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Subdivide", "[", 
           RowBox[{"0", ",", " ", "1", ",", " ", "255"}], "]"}], ",", "\n", 
          "    ", 
          RowBox[{"RGBColor", " ", "@@@", " ", 
           RowBox[{"First", "@", 
            RowBox[{"Import", "[", 
             RowBox[{
             "ColorMapSuitePath", " ", "<>", " ", "\"\</\>\"", " ", "<>", " ",
               "name", " ", "<>", " ", "\"\</\>\"", " ", "<>", " ", "name", 
              " ", "<>", " ", "\"\<.mat\>\""}], "]"}]}]}]}], "}"}]}]}], "}"}],
      ",", "\n", "        ", 
     RowBox[{
      RowBox[{"Blend", "[", 
       RowBox[{"list", ",", " ", 
        RowBox[{
         RowBox[{"{", "##", "}"}], "[", 
         RowBox[{"[", "el", "]"}], "]"}]}], "]"}], " ", "&"}]}], " ", "]"}]}],
   "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Colors", " ", "for", " ", "unordered", " ", "data"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ColorMapSuiteCategorical", "[", "name_String", "]"}], " ", ":=", 
   "  ", 
   RowBox[{"RGBColor", " ", "@@@", " ", 
    RowBox[{"First", "@", 
     RowBox[{"Import", "[", "\n", "            ", 
      RowBox[{
      "ColorMapSuitePath", " ", "<>", " ", "\"\</\>\"", " ", "<>", " ", 
       "name", " ", "<>", " ", "\"\</\>\"", "<>", " ", 
       "\"\<CategoricalPalettes\>\"", "<>", " ", "\"\</\>\"", " ", "<>", " ", 
       "name", " ", "<>", " ", "\"\<S.mat\>\""}], "]"}]}]}]}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Colors", " ", "for", " ", "unordered", " ", "data"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ColorMapSuiteDiscrete", "[", "name_String", "]"}], " ", ":=", " ", 
   RowBox[{"ColorMapSuiteDiscrete", "[", 
    RowBox[{"name", ",", "10"}], "]"}]}], "  "}], "\n", 
 RowBox[{
  RowBox[{"ColorMapSuiteDiscrete", "[", 
   RowBox[{"name_String", ",", " ", "num_Integer"}], "]"}], " ", ":=", "  ", 
  RowBox[{"RGBColor", " ", "@@@", " ", 
   RowBox[{"First", "@", 
    RowBox[{"Import", "[", "\n", "            ", 
     RowBox[{
     "ColorMapSuitePath", " ", "<>", " ", "\"\</\>\"", " ", "<>", " ", "name",
       " ", "<>", " ", "\"\</\>\"", "<>", " ", "\"\<DiscretePalettes\>\"", "<>",
       " ", "\"\</\>\"", " ", "<>", " ", "name", " ", "<>", " ", 
      RowBox[{"ToString", "[", "num", "]"}], " ", "<>", "\"\<.mat\>\""}], 
     "]"}]}]}]}]}], "Code",
