 RowBox[{
  RowBox[{
   RowBox[{"phi", "[", 
    RowBox[{"y_", ",", "z_"}], "]"}], ":=", " ", 
   RowBox[{"Switch", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Norm", "[", 
       RowBox[{"{", 
        RowBox[{"y", ",", "z"}], "}"}], "]"}], "<=", " ", "rad"}], ",", " ", 
     "\n", "                        ", "True", ",", " ", 
     RowBox[{".5", "*", "k", "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"z", "/", "rad"}]}], ")"}]}], ",", "\n", 
     "                        ", "False", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{".5", "*", "k", 
        RowBox[{"(", " ", 
         RowBox[{"#", " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"z", " ", "/", "rad"}], ")"}], " ", "*", " ", 
           RowBox[{"#", "^", "3"}]}]}], " ", ")"}]}], "&"}], "[", 
      RowBox[{"rad", "/", 
       RowBox[{"Norm", "[", 
        RowBox[{"{", 
         RowBox[{"y", ",", "z"}], "}"}], "]"}]}], "]"}]}], " ", "]"}]}], "\n",
   "                        "}], "\n", 
 RowBox[{
  RowBox[{"eField", "[", 
   RowBox[{"y_", ",", "z_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ez", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], ",", "er", ",", "etheta", ",", " ", 
      
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"Norm", "[", 
        RowBox[{"{", 
         RowBox[{"y", ",", "z"}], "}"}], "]"}]}]}], "}"}], ",", "\n", 
    "                    ", 
    RowBox[{
     RowBox[{"er", " ", "=", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"y", ",", "z"}], "}"}], "/", "r"}]}], ";", "\n", 
     "                    ", 
     RowBox[{"etheta", " ", "=", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{"-", "y"}]}], "}"}], "/", "r"}]}], ";", " ", "\n", 
     "                  ", 
     RowBox[{"Switch", "[", 
      RowBox[{
       RowBox[{"r", "<=", " ", "rad"}], ",", " ", "\n", 
       "                        ", "True", ",", " ", 
       RowBox[{".5", "*", "k", "*", 
        RowBox[{"ez", "/", "rad"}]}], ",", "\n", "                        ", 
       "False", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{".5", "*", 
            RowBox[{"k", "/", "rad"}]}], ")"}], "*", 
          RowBox[{"(", " ", 
           RowBox[{
            RowBox[{"er", "*", 
             RowBox[{"(", " ", 
              RowBox[{"#", "-", " ", 
               RowBox[{"2", " ", "*", " ", 
                RowBox[{"#", "^", "2"}], " ", "*", " ", 
                RowBox[{"(", 
                 RowBox[{"z", "/", "r"}], ")"}]}]}], ")"}]}], "-", " ", 
            RowBox[{"etheta", " ", "*", " ", 
             RowBox[{"(", " ", 
              RowBox[{
               RowBox[{"#", "^", "2"}], " ", "*", " ", 
               RowBox[{"(", 
                RowBox[{"y", "/", "r"}], ")"}]}], " ", ")"}]}]}], ")"}]}], 
         "&"}], "[", 
        RowBox[{"rad", "/", "r"}], "]"}]}], "  ", "]"}]}]}], 
   "                     ", "\n", "                     ", "]"}]}], "\n", 
